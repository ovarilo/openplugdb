{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openplugdb.org/schemas/vocabulary.schema.json",
  "title": "OpenPlugDB external vocabulary",
  "description": "Identifiers of an external system (OCPI, Open Charge Map, OpenStreetMap) that connector families may map to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "name", "vocabulary", "source", "licenseNote", "values"],
  "properties": {
    "$schema": { "type": "string" },
    "system": { "enum": ["ocpi-2.2.1", "ocpi-2.3.0", "openchargemap", "openstreetmap"] },
    "name": { "type": "string", "minLength": 1 },
    "vocabulary": {
      "enum": ["closed", "open", "subset"],
      "description": "closed/subset: unknown values are rejected; open: the external system accepts values outside the list."
    },
    "note": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision", "accessed"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 1 },
        "accessed": { "type": "string", "format": "date" }
      }
    },
    "licenseNote": { "type": "string", "minLength": 1 },
    "values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        }
      }
    }
  }
}
