---
import { CATEGORY_LABEL, primaryVisual, url } from '../lib/format.ts';
import type { ConnectorFamily } from '../lib/model.ts';
import { facets } from '../lib/site-data.ts';

interface Props {
  family: ConnectorFamily;
}

const { family } = Astro.props;
const visual = primaryVisual(family.variants);
const f = facets(family);
const searchText = [
  family.id,
  family.name,
  ...family.aliases,
  ...family.standards.map((s) => s.designation),
  ...family.variants.flatMap((v) => [v.name, ...(v.aliases ?? [])]),
]
  .join(' ')
  .toLowerCase();
---

<li
  class="connector-card card"
  data-search={searchText}
  data-category={family.category}
  data-current={f.currentTypes.join(' ')}
  data-phases={f.phases.join(' ')}
  data-gender={f.genders.join(' ')}
  data-status={family.verification.status}
>
  <div class="thumb drawing" aria-hidden={visual ? undefined : 'true'}>
    {
      visual ? (
        <img src={url(`/images/${visual.file}`)} alt="" loading="lazy" width="160" height="160" />
      ) : (
        <span class="no-drawing">No drawing yet</span>
      )
    }
  </div>
  <div class="body">
    <h3><a href={url(`/connectors/${family.id}/`)}>{family.name}</a></h3>
    <p class="muted aliases">{family.aliases.slice(0, 3).join(' · ')}</p>
    <p class="tags">
      <span class="badge">{CATEGORY_LABEL[family.category]}</span>
      {f.currentTypes.map((c) => <span class={`badge ${c}`}>{c.toUpperCase()}</span>)}
      {f.phases.includes(3) && <span class="badge">3-phase</span>}
      {family.verification.status !== 'verified' && <span class={`badge ${family.verification.status}`}>{family.verification.status}</span>}
    </p>
    <p class="standards mono muted">{[...new Set(family.standards.map((s) => s.designation))].join(', ')}</p>
  </div>
</li>

<style>
  .connector-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    position: relative;
    transition: border-color 0.15s;
  }

  .connector-card:hover,
  .connector-card:focus-within {
    border-color: var(--accent);
  }

  .thumb {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    max-height: 11rem;
  }

  .thumb img {
    width: auto;
    height: 100%;
    max-height: 9.5rem;
  }

  .no-drawing {
    font-size: 0.8rem;
    color: #5a6472;
  }

  h3 {
    margin: 0;
  }

  h3 a {
    color: var(--text);
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .body p {
    margin: 0.35rem 0 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .standards,
  .aliases {
    font-size: 0.82rem;
  }
</style>
