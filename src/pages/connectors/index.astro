---
import ConnectorCard from '../../components/ConnectorCard.astro';
import Base from '../../layouts/Base.astro';
import { CATEGORY_LABEL } from '../../lib/format.ts';
import { CATEGORIES } from '../../lib/model.ts';
import { families } from '../../lib/site-data.ts';

const all = families();
---

<Base
  title="Connector catalog"
  description="Browse electrical plugs, sockets and EV connectors: filter by category, AC/DC and phases, search by name, alias or standard."
>
  <h1>Connector catalog</h1>
  <p class="muted">
    {all.length} connector families. Search by name, alias or standard, then filter by characteristics.
  </p>

  <form class="filters card" id="filters" role="search" aria-label="Filter connectors" hidden>
    <div class="field grow">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" placeholder="Type 2, Schuko, IEC 60309, NACS…" autocomplete="off" />
    </div>
    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All</option>
        {CATEGORIES.map((c) => <option value={c}>{CATEGORY_LABEL[c]}</option>)}
      </select>
    </div>
    <fieldset class="field">
      <legend>Current</legend>
      <label><input type="checkbox" name="current" value="ac" /> AC</label>
      <label><input type="checkbox" name="current" value="dc" /> DC</label>
    </fieldset>
    <fieldset class="field">
      <legend>Phases</legend>
      <label><input type="checkbox" name="phases" value="1" /> 1</label>
      <label><input type="checkbox" name="phases" value="3" /> 3</label>
    </fieldset>
    <fieldset class="field">
      <legend>Contacts</legend>
      <label><input type="checkbox" name="gender" value="male" /> Male</label>
      <label><input type="checkbox" name="gender" value="female" /> Female</label>
      <label><input type="checkbox" name="gender" value="mixed" /> Mixed</label>
    </fieldset>
    <p class="count" aria-live="polite" id="count"></p>
  </form>

  <ul class="grid catalog" id="catalog">
    {all.map((family) => <ConnectorCard family={family} />)}
  </ul>
  <p id="empty" class="muted" hidden>No connector matches these filters.</p>
</Base>

<script>
  // Progressive enhancement: without JavaScript the full catalog is listed.
  const form = document.querySelector<HTMLFormElement>('#filters');
  const cards = [...document.querySelectorAll<HTMLElement>('#catalog > li')];
  const count = document.querySelector<HTMLElement>('#count');
  const empty = document.querySelector<HTMLElement>('#empty');

  if (form && count && empty) {
    form.hidden = false;
    const params = new URLSearchParams(location.search);
    for (const [key, value] of params) {
      const fields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(`[name="${CSS.escape(key)}"]`);
      for (const field of fields) {
        if (field instanceof HTMLInputElement && field.type === 'checkbox') field.checked ||= field.value === value;
        else field.value = value;
      }
    }

    const matchesAny = (cardValues: string | undefined, selected: string[]) =>
      selected.length === 0 || selected.some((s) => (cardValues ?? '').split(' ').includes(s));

    const apply = () => {
      const data = new FormData(form);
      const terms = String(data.get('q') ?? '')
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);
      const category = String(data.get('category') ?? '');
      const current = data.getAll('current').map(String);
      const phases = data.getAll('phases').map(String);
      const gender = data.getAll('gender').map(String);
      let visible = 0;
      for (const card of cards) {
        const show =
          terms.every((t) => (card.dataset.search ?? '').includes(t)) &&
          (!category || card.dataset.category === category) &&
          matchesAny(card.dataset.current, current) &&
          matchesAny(card.dataset.phases, phases) &&
          matchesAny(card.dataset.gender, gender);
        card.hidden = !show;
        if (show) visible++;
      }
      count.textContent = `${visible} of ${cards.length} shown`;
      empty.hidden = visible > 0;

      const next = new URLSearchParams();
      for (const [key, value] of data) if (value) next.append(key, String(value));
      const query = next.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    form.addEventListener('input', apply);
    form.addEventListener('submit', (event) => event.preventDefault());
    apply();
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    align-items: flex-end;
    margin: 1.5rem 0;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border: 0;
    padding: 0;
    margin: 0;
  }

  fieldset.field {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
  }

  .field > label,
  legend {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  legend {
    width: 100%;
    margin-bottom: 0.3rem;
  }

  fieldset label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .grow {
    flex: 1 1 16rem;
  }

  .count {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    width: 100%;
  }

  .catalog {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
